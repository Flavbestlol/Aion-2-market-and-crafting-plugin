{
  "schema": 1,
  "id": "market-crafting",
  "name": "Dragon Gear Prices",
  "version": "0.16.0",
  "author": "Flavbest",
  "emblem": "emblem.png",
  "kind": "external",
  "run": {
    "exe": "app/node/node.exe",
    "args": [
      "app/server.js"
    ],
    "hidden": true
  },
  "open": "http://127.0.0.1:7317/",
  "stop": {
    "post": "http://127.0.0.1:7317/api/quit",
    "headers": {
      "X-Flav": "1"
    }
  },
  "health": {
    "get": "http://127.0.0.1:7317/api/status"
  },
  "overlays": [
    {
      "id": "list",
      "name": "Shopping list",
      "page": "http://127.0.0.1:7317/overlay.html",
      "size": [
        360,
        560
      ],
      "min": [
        360,
        60
      ]
    }
  ],
  "hotkeys": [
    {
      "id": "toggle",
      "name": "Show or hide the shopping list",
      "default": "Ctrl+Alt+M"
    },
    {
      "id": "refresh",
      "name": "Refresh prices"
    }
  ],
  "events": {
    "version": 1,
    "types": [
      "market-summary",
      "market-listings",
      "item-stats",
      "inventory",
      "my_profile",
      "my_server"
    ]
  },
  "permissions": {
    "network": [
      "a2-tracker.com",
      "aion2.plaync.com",
      "api-search.plaync.com",
      "assets.playnccdn.com",
      "open.er-api.com"
    ]
  },
  "updates": {
    "github": "Flavbestlol/Aion-2-market-and-crafting-plugin",
    "asset": "market-crafting-<version>.zip"
  }
}
